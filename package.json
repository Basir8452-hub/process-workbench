{
  "name": "process-workbench",
  "version": "0.5.6",
  "private": true,
  "description": "工艺开发工程师个人工作台",
  "author": "Process Workbench",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run --config vitest.config.ts",
    "preview": "vite preview",
    "start": "electron .",
    "package": "npm run build && electron-builder --win nsis --publish never",
    "package:portable": "npm run build && electron-builder --win portable --publish never"
  },
  "build": {
    "appId": "com.process.workbench",
    "productName": "工艺工作台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "工艺工作台"
    },
    "compression": "maximum",
    "publish": [
      {
        "provider": "generic",
        "url": "https://example.com/process-workbench/"
      }
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "antd": "^6.6.6",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  }
}
